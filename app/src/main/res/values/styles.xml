    <style name="TextAppearance.DerYurt.Micro">
        <item name="android:textSize">10sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:textColor">@color/dy_text_primary</item>
        <item name="android:fontFamily">@font/nunito_family</item>
        <item name="fontFamily">@font/nunito_family</item>
    </style>

    <!-- Buton: 48dp, köşe radius_m, BodySmall.Strong. Renkleri ui/DyButton.kt verir. -->
    <style name="Widget.DerYurt.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/dy_radius_m</item>
        <item name="android:textAppearance">@style/TextAppearance.DerYurt.BodySmall.Strong</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/dy_space_4</item>
        <item name="android:paddingEnd">@dimen/dy_space_4</item>
        <item name="backgroundTint">@color/theme_orange_primary</item>
        <item name="android:textColor">@color/dy_on_primary</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Metin buton (zeminsiz, tema renginde) -->
    <style name="Widget.DerYurt.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.DerYurt.BodySmall.Strong</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Kart: zemin surface, köşe radius_m, gölgesiz -->
    <style name="Widget.DerYurt.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/dy_surface</item>
        <item name="cardCornerRadius">@dimen/dy_radius_m</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Bölüm başlığı ("Hesap", "Ayarlar") -->
    <style name="DerYurt.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/dy_space_6</item>
        <item name="android:layout_marginBottom">@dimen/dy_space_2</item>
        <item name="android:textAppearance">@style/TextAppearance.DerYurt.BodySmall.Medium</item>
        <item name="android:textColor">@color/dy_text_secondary</item>
    </style>

    <!-- Giriş kutusu: "Dolu kutu", 48dp, köşe radius_s -->
    <style name="Widget.DerYurt.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/dy_surface</item>
        <item name="boxStrokeColor">@color/dy_input_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/dy_radius_s</item>
        <item name="boxCornerRadiusTopEnd">@dimen/dy_radius_s</item>
        <item name="boxCornerRadiusBottomStart">@dimen/dy_radius_s</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/dy_radius_s</item>
        <item name="hintEnabled">false</item>
        <item name="endIconTint">@color/dy_text_secondary</item>
        <item name="errorTextAppearance">@style/TextAppearance.DerYurt.Caption</item>
        <item name="errorTextColor">@color/dy_error</item>
        <item name="boxStrokeErrorColor">@color/dy_error</item>
        <item name="errorIconDrawable">@null</item>
    </style>
</resources>
