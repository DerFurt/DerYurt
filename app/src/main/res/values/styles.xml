    </style>
    <style name="TextAppearance.DerYurt.Display">
        <item name="android:textSize">24sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dy_text_primary</item>
        <item name="android:fontFamily">@font/nunito_family</item>
        <item name="fontFamily">@font/nunito_family</item>
    </style>
    <style name="TextAppearance.DerYurt.ScreenTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
        <item name="android:textStyle">bold</item>
