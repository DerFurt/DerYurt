<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DerYurt" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Font temaya fontFamily olarak verilmez; textAppearance üzerinden gelir (Tasarım Sistemi §2) -->
        <item name="android:textAppearance">@style/TextAppearance.DerYurt.Body</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.DerYurt.Display</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.DerYurt.ScreenTitle</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.DerYurt.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.DerYurt.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.DerYurt.Body.Strong</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.DerYurt.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.DerYurt.BodySmall</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.DerYurt.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.DerYurt.BodySmall.Strong</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.DerYurt.Caption</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.DerYurt.Micro</item>

        <item name="colorPrimary">@color/theme_orange_primary</item>
        <item name="colorOnPrimary">@color/dy_on_primary</item>
        <item name="colorSurface">@color/dy_surface</item>
        <item name="colorOnSurface">@color/dy_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dy_text_secondary</item>
        <item name="colorOutline">@color/dy_input_outline</item>
        <item name="colorError">@color/dy_error</item>
        <item name="android:colorBackground">@color/dy_bg</item>
        <item name="android:windowBackground">@color/dy_bg</item>
        <item name="elevationOverlayColor">@android:color/transparent</item>
        <item name="android:textColorHint">@color/dy_text_tertiary</item>
    </style>

    <!-- Tema rengi katmanları (imleç, odak çerçevesi, switch) -->
    <style name="ThemeOverlay.DerYurt.Orange" parent="">
        <item name="colorPrimary">@color/theme_orange_primary</item>
        <item name="colorControlActivated">@color/theme_orange_primary</item>
    </style>
    <style name="ThemeOverlay.DerYurt.Blue" parent="">
        <item name="colorPrimary">@color/theme_blue_primary</item>
        <item name="colorControlActivated">@color/theme_blue_primary</item>
    </style>
    <style name="ThemeOverlay.DerYurt.Green" parent="">
        <item name="colorPrimary">@color/theme_green_primary</item>
        <item name="colorControlActivated">@color/theme_green_primary</item>
    </style>
    <style name="ThemeOverlay.DerYurt.Red" parent="">
        <item name="colorPrimary">@color/theme_red_primary</item>
        <item name="colorControlActivated">@color/theme_red_primary</item>
    </style>
</resources>
