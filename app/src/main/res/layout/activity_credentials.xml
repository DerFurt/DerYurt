<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup ekran 1: ilk açılış / bilgileri düzenleme -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dy_space_4"
            android:paddingTop="@dimen/dy_space_8"
            android:paddingEnd="@dimen/dy_space_4"
            android:paddingBottom="@dimen/dy_space_4">

            <FrameLayout
                android:id="@+id/appIcon"
                android:layout_width="@dimen/dy_app_icon"
                android:layout_height="@dimen/dy_app_icon"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dy_space_6">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/dy_on_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dy_space_3"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.DerYurt.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dy_space_3"
                android:gravity="center"
                android:text="@string/cred_subtitle"
                android:textAppearance="@style/TextAppearance.DerYurt.Body"
                android:textColor="@color/dy_text_secondary" />

            <TextView
                android:id="@+id/labelUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dy_space_6"
                android:labelFor="@id/inputUsername"
                android:text="@string/cred_username_label"
                android:textAppearance="@style/TextAppearance.DerYurt.BodySmall.Medium"
                android:textColor="@color/dy_text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutUsername"
                style="@style/Widget.DerYurt.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dy_space_2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputUsername"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/cred_username_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="11"
                    android:paddingStart="@dimen/dy_space_3"
                    android:paddingTop="0dp"
                    android:paddingEnd="@dimen/dy_space_3"
                    android:paddingBottom="0dp"
                    android:textAppearance="@style/TextAppearance.DerYurt.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dy_space_4"
                android:labelFor="@id/inputPassword"
                android:text="@string/cred_password_label"
                android:textAppearance="@style/TextAppearance.DerYurt.BodySmall.Medium"
                android:textColor="@color/dy_text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutPassword"
                style="@style/Widget.DerYurt.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dy_space_2"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/cred_password_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingStart="@dimen/dy_space_3"
                    android:paddingTop="0dp"
                    android:paddingEnd="@dimen/dy_space_3"
                    android:paddingBottom="0dp"
                    android:textAppearance="@style/TextAppearance.DerYurt.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DerYurt.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dy_space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/dy_space_3">

                    <FrameLayout
                        android:id="@+id/privacyIconBox"
                        android:layout_width="@dimen/dy_info_icon_box"
                        android:layout_height="@dimen/dy_info_icon_box">

                        <ImageView
                            android:id="@+id/privacyIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lock" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/privacyText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dy_space_3"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.DerYurt.BodySmall"
                        android:textColor="@color/dy_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dy_space_4"
        android:paddingEnd="@dimen/dy_space_4"
        android:paddingBottom="@dimen/dy_space_6">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.DerYurt.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cred_save_first" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dy_space_3"
            android:gravity="center"
            android:text="@string/cred_disclaimer"
            android:textAppearance="@style/TextAppearance.DerYurt.Caption"
            android:textColor="@color/dy_text_tertiary" />
    </LinearLayout>
</LinearLayout>
